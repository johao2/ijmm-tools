# Public Production Canonical Domain
# Used for absolute URL generation in sitemap.xml, robots.txt, and metadata.
NEXT_PUBLIC_SITE_URL=https://tools.ijmmsystem.com

# Public corporate portal linked from every IJMM Tools route.
NEXT_PUBLIC_CORPORATE_SITE_URL=https://ijmmsystem.com

# AdSense remains inert until all three gates are configured intentionally.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CONSENT_READY=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_MIDDLE=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
