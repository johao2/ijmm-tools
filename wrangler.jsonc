{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ijmm-tools",
  "main": ".open-next/worker.js",
  // Dominio del sitio (Cloudflare crea el registro DNS)
  "routes": [{ "pattern": "tools.ijmmsystem.com", "custom_domain": true }],
  "workers_dev": false,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Referencia a sí mismo (caché de OpenNext); debe coincidir con "name"
    { "binding": "WORKER_SELF_REFERENCE", "service": "ijmm-tools" }
  ],
  "vars": { "SOURCE_CHECK_DAILY_LIMIT": "3" },
  "observability": { "enabled": true }
}
